      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/research/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/research/[id]/request-pdf",
      "regex": "^/research/([^/]+?)/request\\-pdf(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/research/(?<nxtPid>[^/]+?)/request\\-pdf(?:/)?$"
    }
  ],
