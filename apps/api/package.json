{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@repo/contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@swc/core": "^1.11.8",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
