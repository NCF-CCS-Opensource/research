{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@nestjs/*", "drizzle-orm", "drizzle-orm/*", "drizzle-kit", "zod", "zod/*"], "message": "The domain layer must not depend on NestJS, Drizzle, or Zod." }
            ]
          }
        ]
      }
    }
  ]
}
